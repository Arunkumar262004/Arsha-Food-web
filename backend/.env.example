# Copy to backend/.env and fill in. Never commit the real .env.
PORT=5000
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/foodapp?retryWrites=true&w=majority
JWT_SECRET=<long random string>
FRONTEND_URL=http://localhost:5173
STORE_TIMEZONE=Asia/Kolkata

# First admin (created automatically on startup when no admin exists; becomes Super Admin)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Razorpay — test keys start with rzp_test_. The secret never leaves the server.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Optional: Razorpay Dashboard > Webhooks > URL https://<backend>/api/order/razorpay/webhook
# events: payment.captured, order.paid, payment.failed
RAZORPAY_WEBHOOK_SECRET=

# Supabase Storage for product images (Project Settings > API). Leave empty to store on local disk.
# Use the service_role key: it is only used server-side and is never sent to the browser.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=food-images

# Email over SMTP (e.g. Brevo: smtp-relay.brevo.com, port 587 or 2525). FROM must be a verified sender.
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=Food Del
